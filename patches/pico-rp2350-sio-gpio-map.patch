+/* ------------------------------------------------------------------
+ * RP2350 SIO GPIO register map.
+ *
+ * RP2350 INTERLEAVES the SIO GPIO registers; the RP2040 map is
+ * sequential. The engine implements the RP2040 map for BOTH chips
+ * (include/gpio.h:30-39), so an RP2350 guest's SIO_GPIO_OUT_SET
+ * (silicon 0x18) lands on the engine's SIO_GPIO_OUT_CLR (0x18) -> the
+ * bit is CLEARED instead of set, SIO_GPIO_OUT_CLR (0x20) lands on the
+ * engine's SIO_GPIO_OE (0x20) -> the OE register is overwritten with
+ * the write mask, and SIO_GPIO_OE_SET (0x38) lands on nothing at all.
+ *
+ * The M33 never sees it: on RP2350 the pico-sdk drives the ARM GPIO
+ * coprocessor (MCR p0, implemented in src/thumb32.c) instead of the SIO
+ * registers. The RISC-V core has NO coprocessor (pico-sdk
+ * rp2_common/hardware_gpio/include/hardware/gpio_coproc.h:11-14:
+ * "#ifdef __riscv -> #error GPIO coprocessor port is not available on
+ * RISC-V"), so an RV32 guest falls back to the SIO registers and every
+ * GPIO write lands on the wrong register: gpio_put(pin,HIGH) clears the
+ * OUT bit and gpio_set_dir(pin,OUTPUT) is dropped -> the guest can
+ * never drive a pin HIGH on the RV32 arch.
+ *
+ * Map (RP2350 offset -> engine's internal RP2040 offset):
+ *   0x04 IN      -> 0x04       0x14 HI_OUT     -> 0x30
+ *   0x08 HI_IN   -> 0x08       0x18 OUT_SET   -> 0x14
+ *   0x10 OUT     -> 0x10       0x1C HI_OUT_SET-> 0x34
+ *   0x20 OUT_CLR -> 0x18       0x24 HI_OUT_CLR-> 0x38
+ *   0x28 OUT_XOR -> 0x1C       0x2C HI_OUT_XOR-> 0x3C
+ *   0x30 OE      -> 0x20       0x34 HI_OE     -> 0x40
+ *   0x38 OE_SET  -> 0x24       0x3C HI_OE_SET -> 0x44
+ *   0x40 OE_CLR  -> 0x28       0x44 HI_OE_CLR -> 0x48
+ *   0x48 OE_XOR  -> 0x2C       0x4C HI_OE_XOR -> 0x4C
+ */
+static uint32_t sio_gpio_addr(uint32_t addr) {
+    if (!membus_rp2350_mode) return addr;
+    if (addr < SIO_BASE_GPIO || addr >= SIO_BASE_GPIO + 0x100) return addr;
+    uint32_t off = addr - SIO_BASE_GPIO;
+    uint32_t mapped;
+    switch (off) {
+    case 0x04: mapped = 0x04; break; /* GPIO_IN           */
+    case 0x08: mapped = 0x08; break; /* GPIO_HI_IN        */
+    case 0x10: mapped = 0x10; break; /* GPIO_OUT          */
+    case 0x14: mapped = 0x30; break; /* GPIO_HI_OUT       */
+    case 0x18: mapped = 0x14; break; /* GPIO_OUT_SET      */
+    case 0x1C: mapped = 0x34; break; /* GPIO_HI_OUT_SET   */
+    case 0x20: mapped = 0x18; break; /* GPIO_OUT_CLR      */
+    case 0x24: mapped = 0x38; break; /* GPIO_HI_OUT_CLR   */
+    case 0x28: mapped = 0x1C; break; /* GPIO_OUT_XOR      */
+    case 0x2C: mapped = 0x3C; break; /* GPIO_HI_OUT_XOR   */
+    case 0x30: mapped = 0x20; break; /* GPIO_OE           */
+    case 0x34: mapped = 0x40; break; /* GPIO_HI_OE        */
+    case 0x38: mapped = 0x24; break; /* GPIO_OE_SET       */
+    case 0x3C: mapped = 0x44; break; /* GPIO_HI_OE_SET    */
+    case 0x40: mapped = 0x28; break; /* GPIO_OE_CLR       */
+    case 0x44: mapped = 0x48; break; /* GPIO_HI_OE_CLR    */
+    case 0x48: mapped = 0x2C; break; /* GPIO_OE_XOR       */
+    case 0x4C: mapped = 0x4C; break; /* GPIO_HI_OE_XOR    */
+    default: return addr;
+    }
+    return SIO_BASE_GPIO + mapped;
+}
