     fn check_interrupt(&mut self, sys: &System) {
-        // DCIE (bit 5): Digest Calculation Complete Interrupt Enable
-        if (self.sr & 0x08) != 0 && (self.cr & 0x20) != 0 {
+        // RM0090: the completion interrupt fires when HASH_IMR.DCIE (bit 1 of
