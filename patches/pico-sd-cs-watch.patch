+/* ---- SPI CS watch -------------------------------------------------------
+ * The ARM path (M0+/M33) never told the attached SPI device about CS
+ * assert/deassert: spi_device_cs() was only called from the RV32 path
+ * (src/rp2350_rv/rv_membus.c). The SD model gates every byte on
+ * `sd->cs_active` (src/sdcard.c:379), so an ARM guest talking to an SD
+ * card got 0xFF for every response while the MOSI bytes went out
+ * normally (measured on 2026-10-20: 60 MOSI bytes, 0 CS events,
+ * R0/R7/R1/OCR = 0xFF).
+ *
+ * The host tells the engine which GPIO line carries CS; this watch
+ * mirrors the pad level into spi_device_cs(). CS is active-low on every
+ * SD/QSPI shield, so pad LOW == CS asserted. The watch is edge-free:
+ * only a real level change reaches the device. */
+static int gpio_cs_watch_pin = -1;
+static int gpio_cs_watch_spi = 0;
+static int gpio_cs_watch_active = -1;
+
+void gpio_set_cs_watch(int pin, int spi_num) {
+    gpio_cs_watch_pin = (pin >= 0 && pin < NUM_GPIO_PINS) ? pin : -1;
+    gpio_cs_watch_spi = (spi_num >= 0 && spi_num <= 1) ? spi_num : 0;
+    gpio_cs_watch_active = -1;
+}
+
+/* Publish the CS pad level to the SPI device. */
+static void gpio_cs_watch_publish(void) {
+    if (gpio_cs_watch_pin < 0) return;
+    extern void spi_device_cs(int spi_num, int cs_active);
+    uint32_t pin = (uint32_t)gpio_cs_watch_pin;
+    int cs;
+    if (pin < 32) {
+        uint32_t eff = gpio_effective_pins();
+        cs = (int)((eff >> pin) & 1u);
+    } else {
+        /* High bank (RP2350 pins 32..47): gpio_effective_pins() only
+         * covers the low 32 pins, so the level is computed from the
+         * high latches directly (same formula as the low bank). */
+        uint32_t b = pin - 32u;
+        uint32_t eff_hi = (gpio_state.gpio_out_hi & gpio_state.gpio_oe_hi) |
+                          (gpio_state.gpio_in_hi & ~gpio_state.gpio_oe_hi);
+        cs = (int)((eff_hi >> b) & 1u);
+    }
+    int active = cs ? 0 : 1;   /* CS is active-low */
+    if (active == gpio_cs_watch_active) return;
+    gpio_cs_watch_active = active;
+    spi_device_cs(gpio_cs_watch_spi, active);
+}
