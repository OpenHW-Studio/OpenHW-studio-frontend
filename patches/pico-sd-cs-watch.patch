 /* SD/eMMC images from JS buffers -> MEMFS -> native init + SPI attach */
+/* Tell the engine which GPIO line carries the SD card's CS (active low).
+ * The ARM path never reported CS assert/deassert to the SPI device
+ * (spi_device_cs is only called from the RV32 path), so the SD model
+ * stayed at cs_active=0 and answered 0xFF for every byte.
+ * pin: GPIO index 0..47, or -1 to disable the watch.
+ *
+ * The watch is a property of the SPI BUS, not of the card, so it is
+ * armed even when no card is attached (the return value only says
+ * whether a card is present: 0 = card attached, 1 = watch armed with
+ * no card). That keeps the CS edge observable for any SPI device
+ * (an SPI tap, a shield with its own model), not just the SD card. */
+int picoemu_sdcard_cs_pin(int pin) {
+    gpio_set_cs_watch(pin, wasm_sdcard_spi_num);
+    return wasm_sdcard_on ? 0 : 1;
+}
