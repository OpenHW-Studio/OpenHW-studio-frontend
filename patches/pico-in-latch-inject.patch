+/* Host -> guest INPUT latch.
+ *
+ * picoemu_set_gpio() writes the OUT latch only (gpio_set_pin), which the
+ * guest ignores while the pin is an input: the guest-visible IN latch keeps
+ * its reset default (all HIGH, gpio_reset) so digitalRead() is stuck at 1
+ * and no external edge ever reaches IO_BANK0. This export is the missing
+ * route into gpio_set_input_pin(), which updates the IN latch, runs the
+ * edge detector and signals the NVIC exactly like a real pad transition.
+ *
+ * pin: GPIO index (0..47).  val: 0 = LOW, non-zero = HIGH. */
+void picoemu_set_gpio_input(int pin, int val) {
+    if (pin < 0 || pin >= 48) return;
+    gpio_set_input_pin((uint8_t)pin, (uint8_t)(val ? 1 : 0));
+}
+
+/* Silent input-latch force (no edge, no IRQ): models an open-drain slave
+ * holding a line (bit-bang ACK/data bits). Same as gpio_inject_level(). */
+void picoemu_inject_gpio_level(int pin, int val) {
+    if (pin < 0 || pin >= 48) return;
+    gpio_inject_level((uint8_t)pin, (uint8_t)(val ? 1 : 0));
+}
