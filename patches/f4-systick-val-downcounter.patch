+    /// Silicon behaviour of the VAL register (RM0090 §4.4.1 / Cortex-M4
+    /// System Timer): a free-running DOWN-counter that reloads from LOAD
+    /// on the next tick.
+    ///
+    /// The previous model returned LOAD on even reads and CVR (0) on odd
+    /// reads — a latch toggle, not a count. Every guest that derives a
+    /// sub-millisecond time base from VAL was therefore blind: the
+    /// STM32duino core's `getCurrentMicros()`
+    /// (libraries/SrcWrapper/src/stm32/clock.c) reads `SysTick->VAL` for
+    /// the sub-millisecond part of `micros()`, so `micros()` degenerated
+    /// into a 1ms-quantised clock that alternated between m*1000 and
+    /// (m+1)*1000. Measured on the deployed engine bytes (F407, DISCO
+    /// core, LOAD = 167999):
+    ///
+    ///   SysTick->VAL x8      = 0,167999,0,167999,0,167999,0,167999
+    ///   micros() - micros() = 0
+    ///   micros() over delayMicroseconds(500) = 0
+    ///   micros() over a 200K-iteration busy loop = 8000
+    ///
+    /// Any protocol that times sub-millisecond slots with `micros()`
+    /// (DHT22 26us/70us slots, DS18B20 presence/reset windows, 1-Wire
+    /// bit timing) could not decode at all — the F4 DHT22 cell reads NaN
+    /// on every chip for exactly this reason.
+    ///
+    /// The engine's time base is the retired-instruction counter and the
+    /// SysTick period is expressed in the same units (nvic.systick_period
+    /// = LOAD, nvic.last_systick_trigger = instruction count of the
+    /// previous tick), so VAL = LOAD - (instructions since that tick)
+    /// makes the guest's sub-millisecond fraction exact in guest time.
+    fn val(&self, sys: &System) -> u32 {
+        // Counter disabled (CSR.EN == 0): the counter does not run.
+        if self.csr & 1 == 0 || self.rvr == 0 {
+            return 0;
+        }
+        let now = crate::system::instruction_count();
+        let last = {
+            let nvic = sys.p.nvic.borrow();
+            nvic.last_systick_trigger
+        };
+        let period = self.rvr as u64;
+        let elapsed = now.saturating_sub(last).min(period);
+        (period - elapsed) as u32
+    }
 }
 
