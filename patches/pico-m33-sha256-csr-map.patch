-static uint32_t sha256_csr = SHA256_CSR_WDATA_RDY;
+static uint32_t sha256_csr = SHA256_CSR_WDATA_RDY | SHA256_CSR_SUM_VLD | SHA256_CSR_BSWAP;
 static int sha256_bswap = 1;
 
 void sha256_init(void) {
@@ -1409,8 +1409,10 @@ void sha256_init(void) {
     sha256_h[6] = 0x1f83d9ab; sha256_h[7] = 0x5be0cd19;
