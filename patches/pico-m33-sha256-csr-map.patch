     /* START forces WDATA_RDY and SUM_VLD high (silicon behavior). */
-    sha256_csr = SHA256_CSR_WDATA_RDY | SHA256_CSR_SUM_VLD;
-    sha256_bswap = 1;
+    /* START resets the digest state only: BSWAP is a separate CSR bit
+     * and survives a new checksum (as on silicon). */
+    sha256_csr = SHA256_CSR_WDATA_RDY | SHA256_CSR_SUM_VLD |
+                 (sha256_bswap ? SHA256_CSR_BSWAP : 0u);
 }
 
 static uint32_t sha256_rotr(uint32_t x, int n) {
@@ -1466,10 +1468,39 @@ uint32_t sha256_read(uint32_t offset) {
 }
 
 void sha256_write(uint32_t offset, uint32_t val) {
-    offset &= 0xFFF;
+    /* RP2350 atomic aliases: +0x1000 XOR, +0x2000 SET, +0x3000 CLEAR
+     * (pico-sdk hardware/regs/addressmap.h: REG_ALIAS_XOR_BITS /
+     * _SET_BITS / _CLR_BITS). The SDK's hw_set_bits()/hw_clear_bits()
+     * write the MASK to the alias register, so the engine must apply the
+     * alias semantics: masking the offset down to 0xFFF (as before)
+     * turned every "set BSWAP" into "the new CSR value is 0x1000" and
+     * silently dropped every other bit — the digest then came out
+     * byte-swapped (BSWAP lost) and the guest's CSR read-back was
+     * nonsense. */
+    uint32_t alias = offset & 0x3000u;
+    offset &= 0x0FFFu;
     if (offset == SHA256_CSR) {
-        if (val & SHA256_CSR_START) sha256_init();
-        /* BSWAP/DMA_SIZE accepted; ERR bit is W1C */
+        uint32_t csr;
+        if (alias == 0x2000u)      csr = sha256_csr | val;   /* SET   */
+        else if (alias == 0x3000u) csr = sha256_csr & ~val;  /* CLEAR */
+        else if (alias == 0x1000u) csr = sha256_csr ^ val;   /* XOR   */
+        else                      csr = val;                /* plain */
+        /* BSWAP (bit 12) says whether the hardware byte-swaps every
+         * WDATA word. The SDK drives it (hardware/sha256.h
+         * sha256_set_bswap: set for SHA256_BIG_ENDIAN, cleared for
+         * LITTLE_ENDIAN) and byte-swaps the SUM words back in software
+         * (sha256_get_result) — honouring it is what makes the digest
+         * byte-exact. */
+        sha256_bswap = (csr & SHA256_CSR_BSWAP) ? 1 : 0;
+        if (csr & SHA256_CSR_START) {
+            /* START: a new checksum (resets the digest state); the rest
+             * of the CSR keeps its value, START itself is write-only. */
+            sha256_init();
+            csr &= ~SHA256_CSR_START;
+            csr |= (sha256_bswap ? SHA256_CSR_BSWAP : 0u);
+        }
+        sha256_csr = csr;
+        /* DMA_SIZE accepted; ERR bit is W1C */
         if (val & SHA256_CSR_ERR_WDATA_NOT_RDY)
             sha256_csr &= ~SHA256_CSR_ERR_WDATA_NOT_RDY;
         return;
