{
  "name": "openhw-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:page-validation": "playwright test e2e/page-validation.spec.js",
    "test:console-errors": "playwright test e2e/console-error-check.spec.js",
    "test:pages": "npm run test:page-validation && npm run test:console-errors",
    "test:protocol": "npx vite-node src/worker/protocol-compliance.test.mjs",
    "test:rp2040-smoke": "npx vite-node src/worker/rp2040-smoke-matrix.ts",
    "test:rp2040-smoke:watchdog": "node scripts/rp2040-smoke-watchdog.mjs",
    "test:cli-hw-matrix": "npx vite-node src/worker/cli-hardware-compat-matrix.ts",
    "test:cli-hw-matrix:watchdog": "node scripts/cli-hw-matrix-watchdog.mjs",
    "test:cli-hw-matrix:guard": "node scripts/cli-hw-matrix-guard.mjs",
    "report:telemetry-coverage": "node scripts/cli-hw-telemetry-coverage.mjs"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.1",
    "@monaco-editor/react": "^4.7.0",
    "@openhw/emulator": "file:../openhw-studio-emulator",
    "@react-oauth/google": "^0.13.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@xenova/transformers": "^2.17.2",
    "avr8js": "^0.21.0",
    "axios": "^1.6.7",
    "html2canvas": "^1.4.1",
    "intel-hex": "^0.2.0",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "littlefs": "^0.1.0",
    "lucide-react": "^0.577.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "react-simple-code-editor": "^0.14.1",
    "rp2040js": "^0.15.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^1.3.9"
  },
  "peerDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.2",
    "@rollup/rollup-win32-x64-msvc": "4.60.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.1",
    "@tailwindcss/oxide-win32-x64-msvc": "4.2.1",
    "lightningcss-linux-x64-gnu": "1.31.1",
    "lightningcss-win32-x64-msvc": "1.31.1"
  }
}
