lse,\n      \"isHidden\": false,\n      \"isHelp\": false,\n      \"fromLabel\": \"\",\n      \"toLabel\": \"\"\n    },\n    {\n      \"id\": \"w_auto_hc_sr04_1_1\",\n      \"from\": \"hc_sr04_1:TRIG\",\n      \"to\": \"uno1:9\",\n      \"color\": \"green\",\n      \"waypoints\": [],\n      \"isBelow\": false,\n      \"isSocket\": false,\n      \"isHidden\": false,\n      \"isHelp\": false,\n      \"fromLabel\": \"\",\n      \"toLabel\": \"\"\n    },\n    {\n      \"id\": \"w_auto_hc_sr04_1_2\",\n      \"from\": \"hc_sr04_1:ECHO\",\n      \"to\": \"uno1:10\",\n      \"color\": \"green\",\n      \"waypoints\": [],\n      \"isBelow\": false,\n      \"isSocket\": false,\n      \"isHidden\": false,\n      \"isHelp\": false,\n      \"fromLabel\": \"\",\n      \"toLabel\": \"\"\n    },\n    {\n      \"id\": \"w_auto_hc_sr04_1_3\",\n      \"from\": \"hc_sr04_1:GND\",\n      \"to\": \"uno1:GND\",\n      \"color\": \"black\",\n      \"waypoints\": [],\n      \"isBelow\": false,\n      \"isSocket\": false,\n      \"isHidden\": false,\n      \"isHelp\": false,\n      \"fromLabel\": \"\",\n      \"toLabel\": \"\"\n    }\n  ]\n}","blocklyXml":"","projectFiles":[{"id":"project/uno1/uno1.ino","path":"project/uno1/uno1.ino","name":"uno1.ino","kind":"code","boardId":"uno1","boardKind":"arduino_uno","content":"void setup() {\n  // autocoding for hc_sr04_1 start\n  Serial.begin(9600);\n  pinMode(9, OUTPUT);\n  pinMode(10, INPUT);\n  Serial.println(\"HC-SR04 Ready\");\n  // autocoding for hc_sr04_1 end\n\n  // put your setup code here, to run once:\n\n}\n\nvoid loop() {\n  // autocoding for hc_sr04_1 start\n  digitalWrite(9, LOW);\n  delayMicroseconds(2);\n  digitalWrite(9, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(9, LOW);\n  long dur_1 = pulseIn(10, HIGH);\n  float cm_1 = dur_1 / 58.2;\n  float inch_1 = dur_1 / 148.0;\n  Serial.print(\"Distance: \");\n  Serial.print(cm_1, 1);\n  Serial.print(\" cm | \");\n  Serial.print(inch_1, 1);\n  Serial.println(\" in\");\n  delay(500);\n 