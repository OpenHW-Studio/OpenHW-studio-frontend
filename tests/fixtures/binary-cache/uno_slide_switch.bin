º{"schemaVersion":"openhw-project-v2","board":"openhw-arduino-uno","components":[{"id":"uno1","type":"openhw-arduino-uno","label":"Arduino Uno","x":180.3,"y":135.5,"w":425,"h":320,"rotation":0,"attrs":{}},{"id":"slide_switch_1","type":"openhw-slide-switch","label":"Slide Switch","x":172.5,"y":133,"w":45,"h":32,"rotation":0,"attrs":{"value":"","bounce":""}}],"connections":[{"id":"w_auto_slide_switch_1_0","from":"slide_switch_1:1","to":"uno1:5V","color":"red","waypoints":[],"isBelow":false,"isSocket":false,"isHidden":false,"isHelp":false,"fromLabel":"","toLabel":""},{"id":"w_auto_slide_switch_1_1","from":"slide_switch_1:2","to":"uno1:2","color":"green","waypoints":[],"isBelow":false,"isSocket":false,"isHidden":false,"isHelp":false,"fromLabel":"","toLabel":""},{"id":"w_auto_slide_switch_1_2","from":"slide_switch_1:3","to":"uno1:GND","color":"black","waypoints":[],"isBelow":false,"isSocket":false,"isHidden":false,"isHelp":false,"fromLabel":"","toLabel":""}],"code":"{\n  \"board\": \"openhw-arduino-uno\",\n  \"components\": [\n    {\n      \"id\": \"uno1\",\n      \"type\": \"openhw-arduino-uno\",\n      \"label\": \"Arduino Uno\",\n      \"x\": 180.3,\n      \"y\": 135.5,\n      \"w\": 425,\n      \"h\": 320,\n      \"rotation\": 0,\n      \"attrs\": {}\n    },\n    {\n      \"id\": \"slide_switch_1\",\n      \"type\": \"openhw-slide-switch\",\n      \"label\": \"Slide Switch\",\n      \"x\": 172.5,\n      \"y\": 133,\n      \"w\": 45,\n      \"h\": 32,\n      \"rotation\": 0,\n      \"attrs\": {\n        \"value\": \"\",\n        \"bounce\": \"\"\n      }\n    }\n  ],\n  \"connections\": [\n    {\n      \"id\": \"w_auto_slide_switch_1_0\",\n      \"from\": \"slide_switch_1:1\",\n      \"to\": \"uno1:5V\",\n      \"color\": \"red\",\n      \"waypoints\": [],\n      \"isBelow\": false,\n      \"isSocket\": false,\n      \"isHidden\": false,\n      \"isHelp\": false,\n      \"fromLabel\": \"\",\n      \"toLabel\": \"\"\n    },\n    {\n      \"id\": \"w_auto_slide_switch_1_1\",\n      \"from\": \"slide_switch_1:2\",\n      \"to\": \"uno1:2\",\n      \"color\": \"green\",\n      \"waypoints\": [],\n      \"isBelow\": false,\n      \"isSocket\": false,\n      \"isHidden\": false,\n      \"isHelp\": false,\n      \"fromLabel\": \"\",\n      \"toLabel\": \"\"\n    },\n    {\n      \"id\": \"w_auto_slide_switch_1_2\",\n      \"from\": \"slide_switch_1:3\",\n      \"to\": \"uno1:GND\",\n      \"color\": \"black\",\n      \"waypoints\": [],\n      \"isBelow\": false,\n      \"isSocket\": false,\n      \"isHidden\": false,\n      \"isHelp\": false,\n      \"fromLabel\": \"\",\n      \"toLabel\": \"\"\n    }\n  ]\n}","blocklyXml":"","projectFiles":[{"id":"project/uno1/uno1.ino","path":"project/uno1/uno1.ino","name":"uno1.ino","kind":"code","boardId":"uno1","boardKind":"arduino_uno","content":"// autocoding for slide_switch_1 start\nbool lastSwitchState_1 = false;\n// autocoding for slide_switch_1 end\n\nvoid setup() {\n  // autocoding for slide_switch_1 start\n  Serial.begin(9600);\n  pinMode(2, INPUT);\n  pinMode(13, OUTPUT);\n  Serial.println(\"Slide Switch Ready\");\n  // autocoding for slide_switch_1 end\n\n  // put your setup code here, to run once:\n\n}\n\nvoid loop() {\n  // autocoding for slide_switch_1 start\n  bool switchState_1 = digitalRead(2);\n  if (switchState_1 != lastSwitchState_1) {\n    Serial.print(\"Switch: \");\n    Serial.println(switchState_1 ? \"ON\" : \"OFF\");\n    digitalWrite(13, switchState_1 ? HIGH : LOW);\n    lastSwitchState_1 = switchState_1;\n  }\n  delay(50);\n  // autocoding for slide_switch_1 end\n\n  // put your main code here, to run repeatedly:\n\n}\n","dirty":true},{"id":"project/uno1/library.txt","path":"project/uno1/library.txt","name":"library.txt","kind":"code","boardId":"uno1","boardKind":"arduino_uno","content":"# Add your libraries here (one per line, e.g. ArduinoJson@6.21.3)\n","dirty":false}]}£B{"events":[{"ComponentState":{"id":"uno1","key":"txActive","value":true,"time_ms":0}},{"Component