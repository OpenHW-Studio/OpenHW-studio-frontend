{
  "type": "wokwi-ldr-module",
  "label": "LDR Sensor Module (4-pin)",
  "group": "Sensors",
  "w": 100,
  "h": 40,
  "attrs": {},
  "contextMenuDuringRun": true,
  "contextMenuOnlyDuringRun": true,
  "pins": [
    {
      "id": "VCC",
      "x": 100,
      "y": 8,
      "type": "power",
      "description": "Positive power supply"
    },
    {
      "id": "GND",
      "x": 100,
      "y": 16,
      "type": "power",
      "description": "Ground"
    },
    {
      "id": "DO",
      "x": 100,
      "y": 24,
      "type": "output",
      "description": "Digital output"
    },
    {
      "id": "AO",
      "x": 100,
      "y": 32,
      "type": "analog",
      "description": "Analog output"
    }
  ],
  "autowiring": {
    "connections": [
      { "from": "VCC", "to": "arduino:5V" },
      { "from": "GND", "to": "arduino:GND" },
      { "from": "AO", "to": "arduino:A0" }
    ]
  },
  "autocoding": {
    "arduino": {
      "setup": "Serial.begin(9600);\npinMode(3, INPUT);\nSerial.println(\"LDR Sensor Ready\");",
      "loop": "int analog = analogRead(A1);\nint digital = digitalRead(3);\nfloat lux = (1023.0 - analog) / 1023.0 * 1000.0;\nSerial.print(\"LDR Analog: \");\nSerial.print(analog);\nSerial.print(\" | Lux~\");\nSerial.print(lux, 0);\nSerial.print(\" | Dark: \");\nSerial.println(digital == HIGH ? \"YES\" : \"no\");\ndelay(300);"
    }
  }
}