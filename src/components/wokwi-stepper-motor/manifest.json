{
    "type": "wokwi-stepper-motor",
    "label": "Stepper Motor (Bipolar)",
    "group": "Actuators",
    "w": 50,
    "h": 50,
    "attrs": {
        "step_angle": "1.8"
    },
    "pins": [
        {
            "id": "A+",
            "x": 10,
            "y": 50,
            "type": "digital"
        },
        {
            "id": "A-",
            "x": 20,
            "y": 50,
            "type": "digital"
        },
        {
            "id": "B+",
            "x": 30,
            "y": 50,
            "type": "digital"
        },
        {
            "id": "B-",
            "x": 40,
            "y": 50,
            "type": "digital"
        }
    ],
    "autowiring": {
        "connections": [
            { "from": "A+", "to": "a4988_1:1A" },
            { "from": "A-", "to": "a4988_1:2A" },
            { "from": "B+", "to": "a4988_1:1B" },
            { "from": "B-", "to": "a4988_1:2B" }
        ]
    },
    "autocoding": {
        "libraries": ["AccelStepper"],
        "arduino": {
            "setup": "#include <AccelStepper.h>\nAccelStepper stepper(AccelStepper::FULL4WIRE, 8, 10, 9, 11);\nstepper.setMaxSpeed(500);\nstepper.setAcceleration(100);",
            "loop": "stepper.moveTo(200);\nstepper.runToPosition();\ndelay(500);\nstepper.moveTo(0);\nstepper.runToPosition();\ndelay(500);"
        }
    }
}