{
    "type": "wokwi-potentiometer",
    "label": "Rotary Potentiometer",
    "description": "Rotary potentiometer (variable resistor). Outputs an analog voltage proportional to the knob's rotation angle. Use with analogRead() on an Arduino analog pin.",
    "group": "Sensors",
    "w": 75,
    "h": 75,
    "attrs": {
        "value": "50",
        "breadboard": {
            "anchorPin": "SIG"
        }
    },
    "telemetry": {
        "template": "value=${state.value}",
        "criticalKeys": [
            "state.value"
        ]
    },
    "pins": [
        {
            "id": "1",
            "x": 15,
            "y": 68,
            "type": "power",
            "description": "GND"
        },
        {
            "id": "SIG",
            "x": 30,
            "y": 68,
            "type": "analog",
            "description": "SIG"
        },
        {
            "id": "2",
            "x": 45,
            "y": 68,
            "type": "power",
            "description": "VCC"
        }
    ],
    "autowiring": {
        "connections": [
            { "from": "1",   "to": "arduino:GND" },
            { "from": "SIG", "to": "arduino:A0" },
            { "from": "2",   "to": "arduino:5V" }
        ]
    },
    "autocoding": {
        "arduino": {
            "setup": "Serial.begin(9600);\n// Potentiometer connected to A0",
            "loop": "int potVal = analogRead(A0);\nfloat voltage = potVal * (5.0 / 1023.0);\nSerial.print(\"Pot: \");\nSerial.print(potVal);\nSerial.print(\" | \");\nSerial.print(voltage, 2);\nSerial.println(\" V\");\ndelay(200);"
        }
    }
}