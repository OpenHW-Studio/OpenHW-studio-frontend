{
  "label": "MAX7219 Dot Matrix",
  "type": "wokwi-max7219",
  "group": "Outputs",
  "w": 120,
  "h": 80,
  "attrs": {
    "color": "red"
  },
  "telemetry": {
    "template": "intensity=${state.intensity}, isShutdown=${state.shutdown}, decodeMode=${state.decodeMode}",
    "criticalKeys": [
      "state.intensity",
      "state.shutdown"
    ]
  },
  "pins": [
    {
      "id": "VCC",
      "x": 0,
      "y": 20,
      "type": "power"
    },
    {
      "id": "GND",
      "x": 0,
      "y": 30,
      "type": "power"
    },
    {
      "id": "DIN",
      "x": 0,
      "y": 40,
      "type": "input"
    },
    {
      "id": "CS",
      "x": 0,
      "y": 50,
      "type": "input"
    },
    {
      "id": "CLK",
      "x": 0,
      "y": 60,
      "type": "input"
    },
    {
      "id": "VCC_OUT",
      "x": 120,
      "y": 20,
      "type": "power"
    },
    {
      "id": "GND_OUT",
      "x": 120,
      "y": 30,
      "type": "power"
    },
    {
      "id": "DOUT",
      "x": 120,
      "y": 40,
      "type": "output"
    },
    {
      "id": "CS_OUT",
      "x": 120,
      "y": 50,
      "type": "output"
    },
    {
      "id": "CLK_OUT",
      "x": 120,
      "y": 60,
      "type": "output"
    }
  ],
  "autowiring": {
    "connections": [
      { "from": "VCC", "to": "arduino:5V" },
      { "from": "GND", "to": "arduino:GND" },
      { "from": "CLK", "to": "arduino:SCK" },
      { "from": "DIN", "to": "arduino:MOSI" },
      { "from": "CS", "to": "arduino:10" }
    ]
  },
  "autocoding": {
    "libraries": ["LedControl"],
    "arduino": {
      "setup": "#include <LedControl.h>\n\nLedControl lc = LedControl(11, 13, 10, 1);\n\nvoid setup() {\n  lc.shutdown(0, false);\n  lc.setIntensity(0, 8);\n  lc.clearDisplay(0);\n  // Welcome Message (H)\n  lc.setRow(0,0,B01100110);\n  lc.setRow(0,1,B01100110);\n  lc.setRow(0,2,B01100110);\n  lc.setRow(0,3,B01111110);\n  lc.setRow(0,4,B01111110);\n  lc.setRow(0,5,B01100110);\n  lc.setRow(0,6,B01100110);\n  lc.setRow(0,7,B01100110);\n  delay(2000);\n}",
      "loop": "// Dot Matrix ready for animation."
    }
  }
}