{
    "type": "wokwi-led",
    "label": "LED",
    "description": "Light-emitting diode. Emits light when current flows through it. Supports multiple colors via the color attribute.",
    "group": "Outputs",
    "w": 38,
    "h": 38,
    "attrs": {
        "color": "red",
        "breadboard": {
            "anchorPin": "A"
        }
    },
    "telemetry": {
        "template": "illuminated=${state.illuminated}, brightness=${state.brightness}, burnedOut=${state.burnedOut}",
        "criticalKeys": [
            "state.illuminated",
            "state.brightness",
            "state.burnedOut"
        ]
    },
    "pins": [
        {
            "id": "A",
            "x": 10,
            "y": 40,
            "type": "input",
            "description": "Anode (+)"
        },
        {
            "id": "K",
            "x": 25,
            "y": 40,
            "type": "input",
            "description": "Cathode (-)"
        }
    ]
}