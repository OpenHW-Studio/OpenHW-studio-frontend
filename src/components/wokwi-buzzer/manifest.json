{
    "type": "wokwi-buzzer",
    "label": "Buzzer",
    "description": "Piezoelectric buzzer that generates audio tones when driven by PWM or toggled digital signals.",
    "group": "Outputs",
    "w": 68, "h": 90,
    "attrs": {},
    "pins": [
        { "id": "1", "x": 28, "y": 85, "type": "digital", "description": "Positive" },
        { "id": "2", "x": 40, "y": 85, "type": "power",   "description": "Negative" }
    ],
    "autowiring": {
        "connections": [
            { "from": "1", "to": "arduino:8", "via": "wokwi-resistor", "attrs": { "value": "100" } },
            { "from": "2", "to": "arduino:GND" }
        ]
    },
    "autocoding": {
        "arduino": {
            "setup": "pinMode(8, OUTPUT);",
            "loop": "int notes[] = {262, 294, 330, 349, 392, 440, 494, 523};\nint durs[] = {200, 200, 200, 200, 200, 200, 200, 400};\nfor (int i = 0; i < 8; i++) {\n  tone(8, notes[i], durs[i]);\n  delay(durs[i] + 30);\n}\nnoTone(8);\ndelay(1000);"
        }
    }
}